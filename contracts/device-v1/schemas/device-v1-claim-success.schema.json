{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dog-rgb:contract:device-v1:device-v1-claim-success",
  "title": "Dog RGB collar claim result",
  "type": "object",
  "required": [
    "protocol_version",
    "request_id",
    "server_time",
    "pairing",
    "next_sync_after_seconds"
  ],
  "properties": {
    "protocol_version": {"const": 1},
    "request_id": {"$ref": "urn:dog-rgb:contract:device-v1:common#/$defs/uuidV4"},
    "server_time": {"$ref": "urn:dog-rgb:contract:device-v1:common#/$defs/utcDateTime"},
    "pairing": {
      "type": "object",
      "required": ["device_id", "credential_id", "collar_id", "dog_id", "state", "accepted_capability_hash"],
      "properties": {
        "device_id": {"$ref": "urn:dog-rgb:contract:device-v1:common#/$defs/uuidV4"},
        "credential_id": {"$ref": "urn:dog-rgb:contract:device-v1:common#/$defs/uuidV4"},
        "collar_id": {"$ref": "urn:dog-rgb:contract:device-v1:common#/$defs/uuid"},
        "dog_id": {"$ref": "urn:dog-rgb:contract:device-v1:common#/$defs/uuid"},
        "state": {"const": "paired"},
        "accepted_capability_hash": {"$ref": "urn:dog-rgb:contract:device-v1:common#/$defs/sha256Base64Url"}
      },
      "additionalProperties": false
    },
    "next_sync_after_seconds": {"type": "integer", "minimum": 30, "maximum": 86400}
  },
  "additionalProperties": false
}
