{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dog-rgb:contract:device-v1:problem-catalog",
  "title": "Dog RGB stable problem catalog",
  "type": "object",
  "required": ["catalog_version", "type_prefix", "entries"],
  "properties": {
    "catalog_version": {"const": 1},
    "type_prefix": {"const": "urn:dog-rgb:problem:"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "code",
          "status",
          "title",
          "retry_class",
          "device_action",
          "retry_after_allowed",
          "applies_to"
        ],
        "properties": {
          "code": {"$ref": "urn:dog-rgb:contract:device-v1:common#/$defs/machineCode"},
          "status": {"type": "integer", "minimum": 400, "maximum": 599},
          "title": {"type": "string", "minLength": 1, "maxLength": 80},
          "retry_class": {"enum": ["never", "operator", "backoff", "retry_after"]},
          "device_action": {"$ref": "#/$defs/deviceAction"},
          "device_action_overrides": {
            "type": "object",
            "properties": {
              "issue_claim": {"$ref": "#/$defs/deviceAction"},
              "claim": {"$ref": "#/$defs/deviceAction"},
              "sync": {"$ref": "#/$defs/deviceAction"},
              "revoke": {"$ref": "#/$defs/deviceAction"}
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "retry_after_allowed": {"type": "boolean"},
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"enum": ["issue_claim", "claim", "sync", "revoke"]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "deviceAction": {
      "enum": [
        "fix_client_and_retain",
        "retain_and_repair",
        "retain_and_repair_claim",
        "retain_and_repair_identity",
        "retain_and_cool_down",
        "retain_and_honor_retry_after",
        "retain_and_retry_with_jitter",
        "mark_revoked_and_stop",
        "split_and_retain",
        "quarantine_identified_data",
        "browser_reauthenticate",
        "browser_refresh_and_retry",
        "retain_revoke_pending"
      ]
    }
  },
  "additionalProperties": false
}
