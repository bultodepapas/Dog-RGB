{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wokwi ESP32-S3 GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.pio/build/wokwi/firmware.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${userHome}/.platformio/packages/toolchain-xtensa-esp32s3/bin/xtensa-esp32s3-elf-gdb.exe",
      "miDebuggerServerAddress": "localhost:3333",
      "externalConsole": false,
      "stopAtEntry": false
    }
  ]
}
