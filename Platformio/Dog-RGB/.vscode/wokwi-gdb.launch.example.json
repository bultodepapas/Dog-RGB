{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wokwi ESP32-S3 GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.pio/build/wokwi/firmware.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${userHome}/.platformio/packages/tool-xtensa-esp-elf-gdb/bin/xtensa-esp-elf-gdb-no-python.exe",
      "miDebuggerServerAddress": "localhost:3333",
      "externalConsole": false,
      "stopAtEntry": false
    }
  ]
}
