{
  "name": "NMEA GPS simulator",
  "author": "Dog-RGB",
  "pins": ["TX", "RX", "DEBUG"],
  "controls": [
    {
      "id": "profile",
      "label": "Profile: 0 move, 1 stop, 2 no fix, 3 poor HDOP, 4 no signal",
