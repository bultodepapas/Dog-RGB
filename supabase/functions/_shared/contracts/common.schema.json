{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dog-rgb:contract:device-v1:common",
  "title": "Dog RGB device-v1 common types",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "sha256Base64Url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "minLength": 43,
      "maxLength": 43
    },
    "secret256Base64Url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "minLength": 43,
      "maxLength": 43
    },
    "uint8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "uint16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "utcMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "minLength": 24,
      "maxLength": 24
    },
    "localDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "minLength": 10,
      "maxLength": 10
    },
    "ianaTimezone": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._+-]*(?:/[A-Za-z0-9._+-]+)+$",
      "minLength": 3,
      "maxLength": 64
    },
    "firmwareVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "minLength": 5,
      "maxLength": 32
    },
    "hardwareRevision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
      "minLength": 1,
      "maxLength": 32
    },
    "machineCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "minLength": 1,
      "maxLength": 64
    },
    "timeQuality": {
      "enum": [
        "unknown",
        "approximate_persisted",
        "server_anchored",
        "sntp_synced",
        "gnss_trusted"
      ]
    },
    "hlc": {
      "type": "object",
      "required": ["physical_ms", "logical", "actor_id"],
      "properties": {
        "physical_ms": {"$ref": "#/$defs/utcMilliseconds"},
        "logical": {"$ref": "#/$defs/uint32"},
        "actor_id": {"$ref": "#/$defs/uuid"}
      },
      "additionalProperties": false
    },
    "clock": {
      "oneOf": [
        {
          "type": "object",
          "required": ["utc_ms", "quality", "uncertainty_ms"],
          "properties": {
            "utc_ms": {"type": "null"},
            "quality": {"const": "unknown"},
            "uncertainty_ms": {"type": "null"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["utc_ms", "quality", "uncertainty_ms"],
          "properties": {
            "utc_ms": {"$ref": "#/$defs/utcMilliseconds"},
            "quality": {
              "enum": [
                "approximate_persisted",
                "server_anchored",
                "sntp_synced",
                "gnss_trusted"
              ]
            },
            "uncertainty_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "deviceDescriptor": {
      "type": "object",
      "required": [
        "device_id",
        "boot_sequence",
        "firmware_version",
        "hardware_revision",
        "telemetry_schema",
        "config_schema",
        "capability_hash"
      ],
      "properties": {
        "device_id": {"$ref": "#/$defs/uuidV4"},
        "boot_sequence": {"$ref": "#/$defs/uint32"},
        "firmware_version": {"$ref": "#/$defs/firmwareVersion"},
        "hardware_revision": {"$ref": "#/$defs/hardwareRevision"},
        "telemetry_schema": {"const": 3},
        "config_schema": {"const": 7},
        "capability_hash": {"$ref": "#/$defs/sha256Base64Url"}
      },
      "additionalProperties": false
    }
  }
}
