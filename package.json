{
  "name": "dog-rgb-ap-portal-tools",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "smoke": "python3 tools/web_pages_smoke.py",
    "webui:build": "node webui/build.mjs",
    "webui:check": "node webui/build.mjs --check",
    "webui:unit": "node --test webui/*.test.mjs",
    "webui:serve": "node tools/ap_portal_preview/server.mjs --port 4173",
    "webui:test": "npm run webui:check && npm run webui:unit && npm run smoke && playwright test --project=iphone-13-pro-max-chromium",
    "ap-portal:extract": "npm run webui:build",
    "ap-portal:serve": "npm run webui:serve",
    "ap-portal:screenshots": "playwright test tests/ap-portal-visual/ap-portal.visual.spec.ts --project=iphone-13-pro-max-chromium",
    "ap-portal:visual": "AP_PORTAL_VISUAL=1 playwright test tests/ap-portal-visual/ap-portal.visual.spec.ts --project=iphone-13-pro-max-chromium",
    "ap-portal:visual:update": "AP_PORTAL_VISUAL=1 playwright test tests/ap-portal-visual/ap-portal.visual.spec.ts --project=iphone-13-pro-max-chromium --update-snapshots",
    "ap-portal:visual:baseline": "bash tools/ap_portal_preview/gen_baselines.sh",
    "ap-portal:ui": "playwright test tests/ap-portal-visual/ap-portal.visual.spec.ts --project=iphone-13-pro-max-chromium --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "html-minifier-terser": "7.2.0"
  }
}
