# Copy this file to .env.local. Never commit .env.local.
# For the local stack, obtain the current values with: supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_LOCAL_VALUE

# Exact trusted site origin used by Auth confirmation/recovery callbacks.
# For hosted use, set the canonical HTTPS origin and add the exact callback URL
# to Supabase Auth's redirect allowlist. Never derive it from request Host.
PORTAL_SITE_ORIGIN=http://127.0.0.1:3000
